<?xml version="1.0" encoding="utf-8"?>
<!--
  Seek bar track: dim = whole video, light = downloaded ahead of the playhead (secondaryProgress), accent = played.
  Every layer has an explicit height and is centred vertically: a <clip> layer has no height of its own, so without
  this the track stretches to the full height of the SeekBar and ends up thicker than the thumb.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:height="3dp"
        android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="1.5dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/secondaryProgress"
        android:height="3dp"
        android:gravity="center_vertical|fill_horizontal">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#80FFFFFF" />
                <corners android:radius="1.5dp" />
            </shape>
        </clip>
    </item>
    <item
        android:id="@android:id/progress"
        android:height="3dp"
        android:gravity="center_vertical|fill_horizontal">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorPrimary" />
                <corners android:radius="1.5dp" />
            </shape>
        </clip>
    </item>
</layer-list>
